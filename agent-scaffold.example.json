{
  "project": {
    "key": "PACE",
    "repoPath": "."
  },
  "policy": {
    "allowedProjects": [
      "PACE"
    ],
    "requiredLabels": [
      "agent-ready"
    ],
    "humanOnlyStatuses": [
      "Tamam",
      "Done"
    ],
    "maxChangedFiles": 30,
    "maxConcurrency": 3,
    "providerConcurrency": {
      "antigravity": 2,
      "codex": 1
    },
    "pathScopes": {
      "architect": [
        "docs/**",
        "*.md"
      ],
      "backend-engineer": [
        "backend/**"
      ],
      "frontend-engineer": [
        "frontend/**"
      ],
      "devops-engineer": [
        ".github/**",
        "infra/**",
        "scripts/**",
        "docker-compose*.yml"
      ],
      "qa-engineer": [
        "backend/**",
        "frontend/**",
        "cv-engine/**",
        "tests/**"
      ],
      "pm-analyst": [
        "docs/**",
        "*.md"
      ],
      "security-engineer": [],
      "data-engineer": [
        "backend/**"
      ],
      "cv-engineer": [
        "cv-engine/**"
      ]
    }
  },
  "worktree": {
    "root": "../agent-worktrees"
  },
  "jira": {
    "baseUrl": "https://houndvision.atlassian.net",
    "emailEnv": "ATLASSIAN_EMAIL",
    "tokenEnv": "ATLASSIAN_API_TOKEN",
    "writeEnabled": false
  },
  "executor": {
    "defaultProvider": "codex",
    "providers": {
      "codex": {
        "command": [
          "codex",
          "exec",
          "-C",
          "{worktree}",
          "{prompt}"
        ],
        "defaultModel": "gpt-5.6-terra",
        "defaultEffort": "medium",
        "modelProfiles": {
          "luna": "gpt-5.6-luna",
          "terra": "gpt-5.6-terra",
          "sol": "gpt-5.6-sol",
          "low": "gpt-5.6-terra",
          "medium": "gpt-5.6-terra",
          "high": "gpt-5.6-sol"
        },
        "timeoutSeconds": 3600
      },
      "antigravity": {
        "command": [
          "agy",
          "--agent",
          "{agent}",
          "--model",
          "{model}",
          "--mode",
          "{mode}",
          "--sandbox",
          "--output-format",
          "stream-json",
          "--json-schema",
          "{resultSchema}",
          "--log-file",
          "{logFile}",
          "--print-timeout",
          "60m",
          "-p",
          "{prompt}"
        ],
        "cwd": "{worktree}",
        "mode": "accept-edits",
        "defaultModel": "claude-sonnet-4-6",
        "defaultEffort": "medium",
        "modelProfiles": {
          "low": "gemini-3.6-flash-low",
          "medium": "gemini-3.6-flash-low",
          "high": "gemini-3.1-pro-high",
          "gemini-flash": "gemini-3.6-flash-low",
          "gemini-pro": "gemini-3.1-pro-high",
          "claude-review": "claude-sonnet-4-6",
          "mechanical": "gpt-oss-120b-medium",
          "ux": "gemini-3.1-pro-high"
        },
        "resultSchema": "adapters/antigravity/execution-result.schema.json",
        "timeoutSeconds": 3600
      }
    }
  },
  "supervisor": {
    "executeEnabled": false,
    "pollIntervalSeconds": 30,
    "heartbeatSeconds": 10,
    "staleAfterSeconds": 90,
    "maxConsecutiveFailures": 3,
    "issueLimit": 10
  }
}
