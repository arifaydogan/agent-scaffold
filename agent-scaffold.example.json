{
  "project": {
    "key": "PACE",
    "repoPath": ".",
    "name": "PaceBuild"
  },
  "policy": {
    "allowedProjects": [
      "PACE"
    ],
    "requiredLabels": [
      "agent-ready"
    ],
    "humanOnlyStatuses": [
      "Tamam",
      "Done"
    ],
    "maxChangedFiles": 30,
    "maxConcurrency": 3,
    "providerConcurrency": {
      "antigravity": 2,
      "codex": 1
    },
    "pathScopes": {
      "architect": [
        "docs/**",
        "*.md"
      ],
      "backend-engineer": [
        "backend/**"
      ],
      "frontend-engineer": [
        "frontend/**"
      ],
      "devops-engineer": [
        ".github/**",
        "infra/**",
        "scripts/**",
        "docker-compose*.yml"
      ],
      "qa-engineer": [
        "backend/**",
        "frontend/**",
        "cv-engine/**",
        "tests/**"
      ],
      "pm-analyst": [
        "docs/**",
        "*.md"
      ],
      "security-engineer": [],
      "data-engineer": [
        "backend/**"
      ],
      "cv-engineer": [
        "cv-engine/**"
      ]
    }
  },
  "worktree": {
    "root": "../agent-worktrees"
  },
  "workSource": {
    "defaultProvider": "jira",
    "providers": {
      "jira": {
        "type": "jira",
        "baseUrl": "https://houndvision.atlassian.net",
        "emailEnv": "ATLASSIAN_EMAIL",
        "tokenEnv": "ATLASSIAN_API_TOKEN",
        "writeEnabled": false,
        "stateMapping": {
          "ready": [
            "Yapılacaklar"
          ],
          "in_progress": [
            "Devam Ediyor"
          ],
          "review": [
            "Review"
          ],
          "blocked": [
            "Bloke"
          ],
          "done": [
            "Tamam"
          ]
        }
      },
      "github-issues": {
        "type": "github-issues",
        "owner": "arifaydogan",
        "repo": "agent-scaffold",
        "tokenEnv": "GITHUB_TOKEN",
        "writeEnabled": false,
        "stateMapping": {
          "ready": [
            "open",
            "agent-ready"
          ],
          "in_progress": [
            "in-progress"
          ],
          "review": [
            "in-review"
          ],
          "blocked": [
            "blocked"
          ],
          "done": [
            "closed",
            "completed"
          ],
          "cancelled": [
            "not-planned"
          ]
        }
      }
    }
  },
  "orchestrator": {
    "defaultProvider": "builtin",
    "providers": {
      "builtin": {
        "type": "builtin"
      }
    }
  },
  "executor": {
    "defaultProvider": "codex",
    "providers": {
      "codex": {
        "type": "cli",
        "command": [
          "codex",
          "exec",
          "-C",
          "{worktree}",
          "{prompt}"
        ],
        "defaultModel": "gpt-5.6-terra",
        "defaultEffort": "medium",
        "modelProfiles": {
          "luna": "gpt-5.6-luna",
          "terra": "gpt-5.6-terra",
          "sol": "gpt-5.6-sol",
          "low": "gpt-5.6-terra",
          "medium": "gpt-5.6-terra",
          "high": "gpt-5.6-sol"
        },
        "timeoutSeconds": 3600
      },
      "antigravity": {
        "type": "cli",
        "command": [
          "agy",
          "--agent",
          "{agent}",
          "--model",
          "{model}",
          "--mode",
          "{mode}",
          "--sandbox",
          "--output-format",
          "stream-json",
          "--json-schema",
          "{resultSchema}",
          "--log-file",
          "{logFile}",
          "--print-timeout",
          "60m",
          "-p",
          "{prompt}"
        ],
        "cwd": "{worktree}",
        "mode": "accept-edits",
        "defaultModel": "claude-sonnet-4-6",
        "defaultEffort": "medium",
        "modelProfiles": {
          "low": "gemini-3.6-flash-low",
          "medium": "gemini-3.6-flash-low",
          "high": "gemini-3.1-pro-high",
          "gemini-flash": "gemini-3.6-flash-low",
          "gemini-pro": "gemini-3.1-pro-high",
          "claude-review": "claude-sonnet-4-6",
          "mechanical": "gpt-oss-120b-medium",
          "ux": "gemini-3.1-pro-high"
        },
        "resultSchema": "adapters/antigravity/execution-result.schema.json",
        "timeoutSeconds": 3600
      }
    }
  },
  "codeIntelligence": {
    "defaultProvider": "codebase-memory",
    "providers": {
      "codebase-memory": {
        "type": "codebase-memory-mcp",
        "enabled": false,
        "transport": "stdio",
        "command": [
          "codebase-memory-mcp"
        ],
        "readOnly": true,
        "capabilities": [
          "architecture",
          "code-search",
          "impact-analysis",
          "call-graph"
        ]
      }
    }
  },
  "supervisor": {
    "executeEnabled": false,
    "pollIntervalSeconds": 30,
    "heartbeatSeconds": 10,
    "staleAfterSeconds": 90,
    "maxConsecutiveFailures": 3,
    "issueLimit": 10
  },
  "controlPlane": {
    "configMutationEnabled": false
  }
}
